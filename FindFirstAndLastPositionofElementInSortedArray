//Time Complexity : O(logN)+O(logK) = O(logN)
//Space Complexity : O(1)
class FindFirstAndLastPositionofElementInSortedArray {
    public int[] searchRange(int[] nums, int target) {
        if(nums == null || nums.length == 0) return new int[]{-1, -1};
        int n = nums.length;
        if(target < nums[0]) return new int[] {-1, -1};
        if(target > nums[n-1]) return new int[] {-1, -1};
        int firstOccurence = binarySearchFirst(nums, target, 0, n-1);
        if(firstOccurence == -1) return new int[] {-1, -1};
        int lastOccurence =  binarySearchLast(nums, target, firstOccurence, n-1); // will not search entire array will only search from first occurance.
        return new int[] { firstOccurence, lastOccurence};

    }

    private int binarySearchFirst(int[] nums, int target, int low, int high) {
        while(low <= high) {
            int mid = low + (high-low) / 2;
            if(nums[mid] == target) {
                if(mid == 0 || nums[mid] > nums[mid-1]) {
                    return mid;
                } else {
                  //move left side
                  high = mid - 1;
                }
            } else if(nums[mid] > target) {
                //move left side
                high = mid - 1;
            } else {
                //move right side
                low = mid + 1;
            }
         }
         return -1;
    }

    private int binarySearchLast(int[] nums, int target, int low, int high) {
        while(low <= high) {
            int mid = low + (high-low) / 2;
            if(nums[mid] == target) {
                if(mid == nums.length-1 || nums[mid] < nums[mid+1]) {
                    return mid;
                } else {
                    //move right side
                  low = mid + 1;
                }
            } else if(nums[mid] > target) {
                //move left side
                high = mid - 1;
            } else {
                //move right side
                low = mid + 1;
            }
         }
         return -1;
    }
}