'''
My approach:
First check if the array is already sorted, if so return the first element.
If element at mid is smaller than both its neighbors, then it is the minimum element.
Otherwise, move towards the unsorted side as minimum will always be there.
'''
class Solution:
    def findMin(self, nums: List[int]) -> int:
        low = 0
        high = len(nums) - 1

        while low <= high:
            if nums[low] <= nums[high]:
                return nums[low]
            mid = low+(high-low)//2
            # check if neighboring elements are larger
            # we are on the lowest element
            if (mid==0 or nums[mid] < nums[mid-1]) and (mid == len(nums)-1 or nums[mid] < nums[mid+1]):
                return nums[mid]
            
            # move to unsorted side as minimum will always be there
            if nums[mid] > nums[high]:
                # left sorted, reject left
                low = mid + 1
            else:
                high = mid - 1
        return -1